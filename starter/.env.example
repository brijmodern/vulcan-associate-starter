# Copy to .env (never commit .env). Values match docker-compose.infra.yml.
# Inside the `vulcan` Docker network the CLI reaches the databases by
# service name on port 5432 (Vulcan book: guides/get-started/docker/, Step 5).
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=vulcan
WAREHOUSE_PASSWORD=vulcan

STATE_HOST=statestore
STATE_PORT=5432
STATE_DB=statestore
STATE_USER=vulcan
STATE_PASSWORD=vulcan
